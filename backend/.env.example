# ==============================================================================
# JOYBOX PARTY ROOM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and populate with deployment credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

FLASK_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Prod DB: joybox_party_room. Concurrency/automated test DB: joybox_party_room_test.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/joybox_party_room?retryWrites=true&w=majority
MONGODB_DB=joybox_party_room

# SAFETY REQUIREMENT FOR AUTOMATED & CONCURRENCY TESTS:
# Concurrency and unique-index tests MUST refuse to execute unless the database name contains "test".
MONGODB_TEST_DB=joybox_party_room_test
MONGODB_TEST_URI=

# Authentication & Session Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_SESSION_LIFETIME_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_COOKIE_NAME=joybox_admin_session
ADMIN_COOKIE_SECURE=false # Set to true in production over HTTPS
ADMIN_COOKIE_SAMESITE=Lax
ADMIN_RATE_LIMIT_LOGIN_MAX=5
ADMIN_RATE_LIMIT_LOGIN_WINDOW=900
ADMIN_RATE_LIMIT_IP_MAX=10
ADMIN_RATE_LIMIT_IP_WINDOW=60
TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXY_COUNT=1

# Payment Gateway (Razorpay)
# Use test keys in development; never commit rzp_live_ keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Booking Lifecycle & Hold Windows (Reconciled defaults)
HOLD_DURATION_MINUTES=15              # UNCONFIRMED default: 15-minute temporary hold TTL
CHECKOUT_GRACE_MINUTES=15             # UNCONFIRMED default: 15-minute checkout grace
MAX_PAYMENT_WINDOW_MINUTES=30         # UNCONFIRMED default: 30-minute maximum payment extension
PAYMENTS_ENABLED=false                # Master payment switch: false until live Razorpay activation
BOOKINGS_OPEN=false                   # Master bookings switch: false = read-only catalog with WhatsApp contact
GST_RATE_PERCENT=0.0                  # UNCONFIRMED default: 0% tax until GSTIN registration
BUFFER_MINUTES=30                     # Confirmed: 30-minute cleaning & sanitization buffer
SLOT_UNIT_MINUTES=30                  # Confirmed: 30-minute slot units
MAX_ADVANCE_BOOKING_DAYS=90           # Confirmed: 90 days maximum advance booking window

# Refund & Cancellation Tier Rules (UNCONFIRMED - Pending owner policy confirmation)
REFUND_WINDOW_FULL_HOURS=48       # > 48h before start: 100% refund
REFUND_WINDOW_PARTIAL_HOURS=24    # 24h-48h before start: 50% refund
REFUND_WINDOW_PARTIAL_PERCENT=50  # 50% refund amount
REFUND_MIN_NOTICE_HOURS=24        # < 24h before start: non-refundable (0%)

# Rate Limiting (Anti-Slot Hoarding)
RATE_LIMIT_HOLD_PER_IP_MAX=10
RATE_LIMIT_HOLD_PER_IP_WINDOW=60
RATE_LIMIT_HOLD_PER_PHONE_MAX=3
RATE_LIMIT_HOLD_PER_PHONE_WINDOW=600

# Venue Operations
WHATSAPP_NUMBER=917842704429
OPENING_HOUR_IST=9
CLOSING_HOUR_IST=22
ALLOW_BUFFER_PAST_CLOSING=true
